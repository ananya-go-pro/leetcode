class Solution(object):
    def countCommas(self, n):
        """
        :type n: int
        :rtype: int
        """
        if n<1000:
            return 0
        elif n<1000000000:
            if n-10**6+2<0:
                return n-1000+1
            return n-1000+n-10**6+2
        elif n<1000000000000:
            if n-10**9+3<0:
                return n-1000+n-10**6+2
            return n-1000+n-10**6+n-10**9+3
        if n==10**15:
            return n-1000+n-10**6+n-10**9+n-10**12+5
        return n-1000+n-10**6+n-10**9+n-10**12+4
