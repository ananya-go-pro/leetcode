class MyStack(object):

    def __init__(self):
        self.q1=[]
        self.q2=[]
        self.count=0

    def push(self, x):
        """
        :type x: int
        :rtype: None
        """
        self.q2.append(x)
        for i in range(self.count):
            self.q2.append(self.q1.pop(0))
        self.count+=1
        for i in range(self.count):
            self.q1.append(self.q2.pop(0))

    def pop(self):
        """
        :rtype: int
        """
        r=self.q1.pop(0)
        self.count-=1
        return r

    def top(self):
        """
        :rtype: int
        """
        r=self.q1[0]
        return r

    def empty(self):
        """
        :rtype: bool
        """
        if self.count==0:
            return True
        return False


