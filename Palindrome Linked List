# Definition for singly-linked list.
# class ListNode(object):
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution(object):
    def isPalindrome(self, head):
        """
        :type head: Optional[ListNode]
        :rtype: bool
        """
        a=""
        temp=head
        while temp!=None:
            a+=str(temp.val)
            temp=temp.next
        if a==a[::-1]:
            return True
        return False
